ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
PROJECTS_DIR=/srv/linux-manager/projects
COOKIE_SECURE=false
TERMINAL_ENABLED=false

# IP/CIDR de origem do Traefik vistos pelo Linux Manager (NUNCA 0.0.0.0/0)
# Necessário para reconhecer HTTPS terminado no proxy em operações de bancos.
TRUSTED_PROXY_IPS=

# Apenas no primeiro boot com banco de identidades vazio (o login passa a exigir usuário admin).
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.invalid
# Opcional: caminho alternativo para banco SQLite privado. Padrão: /srv/linux-manager/auth/manager-auth.sqlite3
# AUTH_DATABASE_PATH=
